# syntax=docker/dockerfile:1

FROM oven/bun:1-slim AS base

FROM base AS pruner
WORKDIR /app
RUN bun add -g turbo
COPY . .
RUN turbo prune @repo/backend --docker

# Full install (incl. devDependencies) — needed to run `prisma generate`,
# discarded after; only its generated client output makes it into the runner.
FROM base AS builder
WORKDIR /app
COPY --from=pruner /app/out/json/ .
RUN bun install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN cd packages/db-prisma && bunx prisma generate

# Used only by the k8s db-migrate initContainer. Reuses the builder stage's
# node_modules, which already has the prisma CLI installed locally as a
# devDependency — avoids `bunx prisma` fetching it fresh over the network on
# every pod start (which hangs in some cluster network setups). Not part of
# the lean runtime image the app itself ships in.
FROM builder AS migrator
WORKDIR /app/packages/db-prisma
CMD ["bunx", "prisma", "migrate", "deploy"]

# Production-only install, kept separate so devDependencies (prisma CLI,
# typescript, test libs, ...) never reach the runtime image.
FROM base AS prod-deps
WORKDIR /app
COPY --from=pruner /app/out/json/ .
RUN bun install --frozen-lockfile --production --omit=peer

FROM oven/bun:1-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup -S -g 1001 backend \
 && adduser -S -u 1001 -G backend backend

COPY --from=prod-deps --chown=backend:backend /app .
COPY --from=pruner --chown=backend:backend /app/out/full/ .
COPY --from=builder --chown=backend:backend /app/packages/db-prisma/src/generated ./packages/db-prisma/src/generated

USER backend
EXPOSE 4000
CMD ["bun", "./apps/backend/src/index.ts"]
